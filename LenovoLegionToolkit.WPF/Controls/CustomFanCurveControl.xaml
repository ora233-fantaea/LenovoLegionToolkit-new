<UserControl
    x:Class="LenovoLegionToolkit.WPF.Controls.CustomFanCurveControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    FlowDirection="LeftToRight"
    Focusable="True"
    KeyDown="UserControl_KeyDown"
    MouseLeftButtonDown="UserControl_MouseLeftButtonDown">
    <Grid Margin="0,8,0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Y-axis labels  -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,6,8,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="100%" />
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="80%" />
            <TextBlock
                Grid.Row="4"
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="60%" />
            <TextBlock
                Grid.Row="6"
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="40%" />
            <TextBlock
                Grid.Row="8"
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="20%" />
            <TextBlock
                Grid.Row="10"
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="0%" />
        </Grid>

        <!--  Interactive graph surface  -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid ClipToBounds="True">
                <Canvas
                    x:Name="_canvas"
                    Background="Transparent"
                    ClipToBounds="True"
                    LostMouseCapture="Canvas_LostMouseCapture"
                    MouseLeave="Canvas_MouseLeave"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                    MouseMove="Canvas_MouseMove"
                    MouseRightButtonDown="Canvas_MouseRightButtonDown"
                    MouseRightButtonUp="Canvas_MouseRightButtonUp"
                    PreviewMouseWheel="Canvas_PreviewMouseWheel"
                    SizeChanged="Canvas_SizeChanged" />

                <!--  Inline quick-edit popover (double-click a point)  -->
                <Canvas x:Name="_overlayCanvas" Background="{x:Null}">
                    <Border
                        x:Name="_inlineEditor"
                        Padding="8,5,8,5"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource PaletteLightBlueBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        MouseLeftButtonDown="InlineEditor_MouseLeftButtonDown"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox
                                x:Name="_inlineTempBox"
                                Width="42"
                                Padding="4,2,4,2"
                                FontSize="12"
                                HorizontalContentAlignment="Center"
                                KeyDown="InlineEditor_KeyDown"
                                MaxLength="3" />
                            <TextBlock
                                Margin="3,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{x:Static resources:Resource.Celsius}" />
                            <TextBox
                                x:Name="_inlineSpeedBox"
                                Width="42"
                                Padding="4,2,4,2"
                                FontSize="12"
                                HorizontalContentAlignment="Center"
                                KeyDown="InlineEditor_KeyDown"
                                MaxLength="3" />
                            <TextBlock
                                Margin="3,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="%" />
                            <Button
                                Padding="8,2,8,2"
                                Click="InlineEditorApply_Click"
                                Content="✓"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!--  X-axis temperature labels (every 10°C from 20°C to 100°C)  -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Margin="10,6,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="20°" />
            <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="30°" />
            <TextBlock Grid.Column="4" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="40°" />
            <TextBlock Grid.Column="6" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="50°" />
            <TextBlock Grid.Column="8" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="60°" />
            <TextBlock Grid.Column="10" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="70°" />
            <TextBlock Grid.Column="12" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="80°" />
            <TextBlock Grid.Column="14" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="90°" />
            <TextBlock Grid.Column="16" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="100°" />
        </Grid>

        <!--  Axis unit hint  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,6,8,0"
            HorizontalAlignment="Right"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="{x:Static resources:Resource.FanCurveControl_FanSpeed}" />
    </Grid>
</UserControl>
