<wpfui:UiPage
    x:Class="LenovoLegionToolkit.WPF.Pages.FanCurvePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.FanCurvePage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Scrollable="True">

    <StackPanel Margin="0,0,16,12">

        <!--  Page header + live status badge  -->
        <Grid Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Focusable="True"
                FontSize="24"
                FontWeight="Medium"
                Text="{x:Static resources:Resource.FanCurvePage_Title}" />

            <custom:Badge
                x:Name="_statusBadge"
                Grid.Column="1"
                Padding="10,4,10,4"
                VerticalAlignment="Center"
                Appearance="Secondary"
                Content="{x:Static resources:Resource.FanCurvePage_Status_Disabled}" />
        </Grid>

        <!--  Contextual warnings  -->
        <custom:InfoBar
            x:Name="_powerModeWarningInfoBar"
            Title="{x:Static resources:Resource.FanCurvePage_PowerModeWarning_Title}"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="False"
            Message="{x:Static resources:Resource.FanCurvePage_PowerModeWarning_Message}"
            Severity="Warning">
            <wpfui:Button
                Margin="0,8,0,0"
                Appearance="Primary"
                Click="SwitchToCustomModeButton_Click"
                Content="{x:Static resources:Resource.FanCurvePage_SwitchToCustomMode}"
                Icon="Gauge24" />
        </custom:InfoBar>

        <custom:InfoBar
            x:Name="_fullSpeedWarningInfoBar"
            Title="{x:Static resources:Resource.FanCurvePage_FullSpeedWarning_Title}"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="False"
            Message="{x:Static resources:Resource.FanCurvePage_FullSpeedWarning_Message}"
            Severity="Warning" />

        <!--  Live telemetry strip  -->
        <Border
            Margin="0,0,0,16"
            Padding="16,12,16,12"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.FanCurvePage_Live_CpuTemp}" />
                    <TextBlock
                        x:Name="_cpuTempText"
                        Margin="0,4,0,0"
                        FlowDirection="LeftToRight"
                        FontSize="18"
                        FontWeight="Medium"
                        Text="-" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.FanCurvePage_Live_GpuTemp}" />
                    <TextBlock
                        x:Name="_gpuTempText"
                        Margin="0,4,0,0"
                        FlowDirection="LeftToRight"
                        FontSize="18"
                        FontWeight="Medium"
                        Text="-" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.FanCurvePage_Live_FanSpeed}" />
                    <TextBlock
                        x:Name="_fanSpeedText"
                        Margin="0,4,0,0"
                        FlowDirection="LeftToRight"
                        FontSize="16"
                        FontWeight="Medium"
                        Text="-" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.FanCurvePage_Live_Target}" />
                    <TextBlock
                        x:Name="_targetText"
                        Margin="0,4,0,0"
                        FlowDirection="LeftToRight"
                        FontSize="16"
                        FontWeight="Medium"
                        Text="-" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Enable toggle  -->
        <custom:CardControl Margin="0,0,0,8" Icon="Temperature24">
            <custom:CardControl.Header>
                <controls:CardHeaderControl
                    Title="{x:Static resources:Resource.FanCurvePage_Enable_Title}"
                    Subtitle="{x:Static resources:Resource.FanCurvePage_Enable_Message}" />
            </custom:CardControl.Header>
            <wpfui:ToggleSwitch
                x:Name="_enableToggle"
                AutomationProperties.Name="{x:Static resources:Resource.FanCurvePage_Enable_Title}"
                Click="EnableToggle_Click" />
        </custom:CardControl>

        <!--  Control mode selector  -->
        <custom:CardControl Margin="0,0,0,16" Icon="Gauge24">
            <custom:CardControl.Header>
                <controls:CardHeaderControl
                    Title="{x:Static resources:Resource.FanCurvePage_Mode_Title}"
                    Subtitle="{x:Static resources:Resource.FanCurvePage_Mode_Message}" />
            </custom:CardControl.Header>
            <ComboBox
                x:Name="_modeComboBox"
                MinWidth="180"
                AutomationProperties.Name="{x:Static resources:Resource.FanCurvePage_Mode_Title}"
                SelectionChanged="ModeComboBox_SelectionChanged" />
        </custom:CardControl>

        <!--  Fixed fan speed card  -->
        <custom:CardControl
            x:Name="_fixedSpeedCard"
            Margin="0,0,0,16"
            Visibility="Collapsed">
            <custom:CardControl.Header>
                <StackPanel>
                    <controls:CardHeaderControl
                        Title="{x:Static resources:Resource.FanCurvePage_FixedSpeed_Title}"
                        Subtitle="{x:Static resources:Resource.FanCurvePage_FixedSpeed_Message}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="_fixedSpeedSlider"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="0"
                            TickFrequency="10"
                            TickPlacement="BottomRight"
                            ValueChanged="FixedSpeedSlider_ValueChanged" />
                        <TextBlock
                            x:Name="_fixedSpeedValueText"
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight"
                            FontSize="14"
                            FontWeight="Medium"
                            TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </custom:CardControl.Header>
        </custom:CardControl>

        <!--  Interactive temperature curve editor card (Border instead of ButtonBase CardControl so mouse capture and focus are never hijacked)  -->
        <Border
            x:Name="_curveCard"
            Margin="0,0,0,16"
            Padding="16,14,16,14"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:CardHeaderControl
                            Grid.Column="0"
                            Title="{x:Static resources:Resource.FanCurvePage_Curve_Title}"
                            Subtitle="{x:Static resources:Resource.FanCurvePage_Curve_Message}" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <wpfui:Button
                                Margin="0,0,6,0"
                                Click="QuietPresetButton_Click"
                                Content="{x:Static resources:Resource.FanCurvePage_Preset_Quiet}" />
                            <wpfui:Button
                                Margin="0,0,6,0"
                                Click="BalancedPresetButton_Click"
                                Content="{x:Static resources:Resource.FanCurvePage_Preset_Balanced}" />
                            <wpfui:Button
                                Click="PerformancePresetButton_Click"
                                Content="{x:Static resources:Resource.FanCurvePage_Preset_Performance}" />
                        </StackPanel>
                    </Grid>

                    <controls:CustomFanCurveControl
                        x:Name="_curveControl"
                        Margin="0,12,0,8" />

                    <!--  All curve points quick-select pills  -->
                    <WrapPanel
                        x:Name="_pointsPanel"
                        Margin="0,4,0,12"
                        Orientation="Horizontal" />

                    <!--  Selected point editor row  -->
                    <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <StackPanel
                            Margin="0,0,16,8"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{x:Static resources:Resource.FanCurvePage_SelectedPoint_Temperature}" />
                            <wpfui:NumberBox
                                x:Name="_pointTempBox"
                                Width="150"
                                ClearButtonEnabled="False"
                                LostFocus="PointBox_LostFocus"
                                MaxDecimalPlaces="0"
                                Maximum="100"
                                Minimum="20"
                                PreviewKeyDown="PointBox_PreviewKeyDown"
                                PreviewTextInput="PointBox_PreviewTextInput"
                                SmallChange="1"
                                TextChanged="PointBox_TextChanged" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,0,16,8"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{x:Static resources:Resource.FanCurvePage_SelectedPoint_Speed}" />
                            <wpfui:NumberBox
                                x:Name="_pointSpeedBox"
                                Width="150"
                                ClearButtonEnabled="False"
                                LostFocus="PointBox_LostFocus"
                                MaxDecimalPlaces="0"
                                Maximum="100"
                                Minimum="0"
                                PreviewKeyDown="PointBox_PreviewKeyDown"
                                PreviewTextInput="PointBox_PreviewTextInput"
                                SmallChange="1"
                                TextChanged="PointBox_TextChanged" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <wpfui:Button
                                x:Name="_addPointButton"
                                Margin="0,0,8,0"
                                Click="AddPointButton_Click"
                                Content="{x:Static resources:Resource.FanCurvePage_AddPoint}"
                                Icon="Add24" />
                            <wpfui:Button
                                x:Name="_removePointButton"
                                Click="RemovePointButton_Click"
                                Content="{x:Static resources:Resource.FanCurvePage_RemovePoint}"
                                Icon="Delete24" />
                        </StackPanel>
                    </WrapPanel>

                    <!--  Explicit Apply / Revert bar  -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="_unsavedChangesText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{x:Static resources:Resource.FanCurvePage_UnsavedChanges}"
                            Visibility="Collapsed" />

                        <wpfui:Button
                            x:Name="_revertCurveButton"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,8,0"
                            Click="RevertCurveButton_Click"
                            Content="{x:Static resources:Resource.FanCurvePage_Revert}"
                            Icon="ArrowClockwise24"
                            IsEnabled="False" />

                        <wpfui:Button
                            x:Name="_applyCurveButton"
                            Grid.Column="2"
                            MinWidth="110"
                            Appearance="Primary"
                            Click="ApplyCurveButton_Click"
                            Content="{x:Static resources:Resource.Apply}"
                            Icon="Checkmark24"
                            IsEnabled="False" />
                    </Grid>
            </StackPanel>
        </Border>

        <!--  Temperature source  -->
        <custom:CardControl x:Name="_sourceCard" Margin="0,0,0,8">
            <custom:CardControl.Header>
                <controls:CardHeaderControl
                    Title="{x:Static resources:Resource.FanCurvePage_Source_Title}"
                    Subtitle="{x:Static resources:Resource.FanCurvePage_Source_Message}" />
            </custom:CardControl.Header>
            <ComboBox
                x:Name="_sourceComboBox"
                MinWidth="180"
                AutomationProperties.Name="{x:Static resources:Resource.FanCurvePage_Source_Title}"
                SelectionChanged="SourceComboBox_SelectionChanged" />
        </custom:CardControl>

        <!--  Hysteresis  -->
        <custom:CardControl x:Name="_hysteresisCard" Margin="0,0,0,8">
            <custom:CardControl.Header>
                <controls:CardHeaderControl
                    Title="{x:Static resources:Resource.FanCurvePage_Hysteresis_Title}"
                    Subtitle="{x:Static resources:Resource.FanCurvePage_Hysteresis_Message}" />
            </custom:CardControl.Header>
            <wpfui:NumberBox
                x:Name="_hysteresisBox"
                Width="150"
                AutomationProperties.Name="{x:Static resources:Resource.FanCurvePage_Hysteresis_Title}"
                ClearButtonEnabled="False"
                LostFocus="ParameterBox_LostFocus"
                MaxDecimalPlaces="0"
                Maximum="20"
                Minimum="0"
                PreviewKeyDown="ParameterBox_PreviewKeyDown"
                PreviewTextInput="ParameterBox_PreviewTextInput"
                SmallChange="1"
                TextChanged="ParameterBox_TextChanged" />
        </custom:CardControl>

        <!--  Polling interval  -->
        <custom:CardControl Margin="0,0,0,8">
            <custom:CardControl.Header>
                <controls:CardHeaderControl
                    Title="{x:Static resources:Resource.FanCurvePage_Interval_Title}"
                    Subtitle="{x:Static resources:Resource.FanCurvePage_Interval_Message}" />
            </custom:CardControl.Header>
            <wpfui:NumberBox
                x:Name="_intervalBox"
                Width="150"
                AutomationProperties.Name="{x:Static resources:Resource.FanCurvePage_Interval_Title}"
                ClearButtonEnabled="False"
                LostFocus="ParameterBox_LostFocus"
                MaxDecimalPlaces="0"
                Maximum="30"
                Minimum="1"
                PreviewKeyDown="ParameterBox_PreviewKeyDown"
                PreviewTextInput="ParameterBox_PreviewTextInput"
                SmallChange="1"
                TextChanged="ParameterBox_TextChanged" />
        </custom:CardControl>

        <!--  Critical temperature protection  -->
        <custom:CardControl Margin="0,0,0,8">
            <custom:CardControl.Header>
                <controls:CardHeaderControl
                    Title="{x:Static resources:Resource.FanCurvePage_CriticalTemp_Title}"
                    Subtitle="{x:Static resources:Resource.FanCurvePage_CriticalTemp_Message}" />
            </custom:CardControl.Header>
            <wpfui:NumberBox
                x:Name="_criticalTempBox"
                Width="150"
                AutomationProperties.Name="{x:Static resources:Resource.FanCurvePage_CriticalTemp_Title}"
                ClearButtonEnabled="False"
                LostFocus="ParameterBox_LostFocus"
                MaxDecimalPlaces="0"
                Maximum="105"
                Minimum="70"
                PreviewKeyDown="ParameterBox_PreviewKeyDown"
                PreviewTextInput="ParameterBox_PreviewTextInput"
                SmallChange="1"
                TextChanged="ParameterBox_TextChanged" />
        </custom:CardControl>

    </StackPanel>
</wpfui:UiPage>
